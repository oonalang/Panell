CI_ENVIRONMENT = production
app.baseURL = 'https://shaii.x10.mx/'
app.forceGlobalSecureRequests = true

database.default.hostname = localhost
database.default.database = REPLACE_WITH_DATABASE_NAME
database.default.username = REPLACE_WITH_DATABASE_USER
database.default.password = REPLACE_WITH_DATABASE_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

encryption.key = REPLACE_WITH_RANDOM_ENCRYPTION_KEY
security.csrfProtection = session

# Keep .env outside your public webroot; never upload it to a public repo.
