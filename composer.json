{
  "name": "eliwoahzja/shai-panel",
  "description": "SHAI Panel - CodeIgniter 4 application with SHAI DDoS protection library",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.2",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-curl": "*",
    "codeigniter4/framework": "^4.7.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.16"
  }
}
