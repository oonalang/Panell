Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Prefer pointing the hosting document root at public/ instead.
    # These directories must never be served when using the root fallback.
    RewriteRule ^(?:app|vendor|writable|tests|sql|project-root|cgi-bin|\.git|\.github)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:uploads|\.well-known)/.*\.(?:php|phtml|phar|phps)$ - [F,L,NC]
    RewriteRule ^(?:composer\.(?:json|lock)|phpunit\.xml(?:\.dist)?|spark|conn\.php|README\.md|ANALYSIS\.md|SECURITY\.md|Newkeys\.txt|.*\.(?:sql|bak|ini|log))$ - [F,L,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

<FilesMatch "^(?:\.|.*\.(?:env|ini|log|bak|sql))">
    Require all denied
</FilesMatch>
